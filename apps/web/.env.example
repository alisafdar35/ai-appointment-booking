# Copy to apps/web/.env.local. Next.js reads its environment from this folder,
# not from the repo-root .env. Both default to http://localhost:4000.

# Where the Next.js server proxies /api/* to (server-side only).
API_ORIGIN=http://localhost:4000
# The browser connects to Socket.IO directly (websockets do not survive the Next.js rewrite).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
