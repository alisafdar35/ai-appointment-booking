# Copy to .env (repo root) and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# --- Database -----------------------------------------------------------------
# Local: docker compose (port 5433). Production: managed Postgres (e.g. Neon) —
# set DATABASE_SSL=true there.
DATABASE_URL=postgresql://appt:appt_local_dev@localhost:5433/appt
DATABASE_SSL=false
PG_POOL_MAX=10
# Optional. The API test suite (npm test -w @appt/api) drops and recreates the
# schema of the database named here, so the name must end in _test; parallel
# test files add _1, _2, ... suffixes. Unset, it uses this server's appt_test.
TEST_DATABASE_URL=postgresql://appt:appt_local_dev@localhost:5433/appt_test

# --- Auth ---------------------------------------------------------------------
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The placeholder below is public, so the API refuses to start with it in production.
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated exact origins allowed to call the API (no wildcard: cookies are credentialed).
# Also the CSRF allow-list: a POST/PUT/PATCH/DELETE carrying any other Origin is
# refused, and the Next.js proxy forwards the browser's Origin — so the web app's
# own origin must be listed here.
CORS_ORIGINS=http://localhost:3000
# Set true only when web and API are on different sites (cookies become SameSite=None; Secure).
CROSS_SITE_COOKIES=false

# --- AI -----------------------------------------------------------------------
# Optional. Without a key the app runs on the deterministic fallback extractor.
# Free key: https://console.mistral.ai/
MISTRAL_API_KEY=
# A small, fast model is enough for slot extraction into a validated schema, and
# it is available on Mistral's free tier (larger models may have no free quota).
MISTRAL_MODEL=ministral-8b-latest
MISTRAL_BASE_URL=https://api.mistral.ai
AI_TIMEOUT_MS=12000
AI_MAX_RETRIES=1
AI_HISTORY_TURNS=12

# --- Misc ---------------------------------------------------------------------
# Reverse proxies in front of the API that append to X-Forwarded-For. 0 locally
# (nothing in front, so the header is not trusted); 2 behind Vercel -> Render.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
RATE_LIMIT_DISABLED=false

# --- Web (apps/web) -----------------------------------------------------------
# Next.js does NOT read this file: it loads its environment from apps/web/.env*
# (see apps/web/.env.example). The two keys it uses are API_ORIGIN, where the
# Next.js server proxies /api/* to, and NEXT_PUBLIC_SOCKET_URL, the Socket.IO
# server the browser connects to directly. Both default to http://localhost:4000.
